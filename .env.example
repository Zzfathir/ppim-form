# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API (or `npx supabase status` for local dev)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable / anon key (safe for the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service_role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Google emails that become superadmin on sign-in.
SUPERADMIN_EMAILS=ahmadfathir0830@gmail.com

# Public base URL of the app (used for share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
