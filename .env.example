# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API (or `npx supabase status` for local dev)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable / anon key (safe for the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service_role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Google emails that become superadmin on sign-in.
SUPERADMIN_EMAILS=ahmadfathir0830@gmail.com

# Public base URL of the app (used for share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Sheets live sync (optional; the feature is hidden until all three are set) ---
# The same Google OAuth client used for sign-in (Google Cloud → Credentials). Enable the
# Google Sheets API, add the scope .../auth/drive.file, and add the redirect URI
# <NEXT_PUBLIC_APP_URL>/api/google/callback to that client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32 random bytes, base64. Encrypts stored Google refresh tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_KEY=
